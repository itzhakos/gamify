+// A vertex shader may read an input location that VkPipelineVertexInputStateCreateInfo
+// does not describe. Vulkan drivers build such a pipeline and the input reads an undefined
+// value; Metal refuses it ("Vertex attribute ... is missing from the vertex descriptor").
+// Wolfenstein II does this, also in pipelines without any vertex buffer. Feed each such
+// active attribute from a vertex buffer the pipeline already uses, or else from a small
+// zero buffer, at offset 0, with a 1-byte format of the attribute's class (always within
+// the stride; Metal fills the missing components with 0, 0, 1).
+void MVKGraphicsPipeline::addUnprovidedVertexAttributes(MTLRenderPipelineDescriptor* plDesc) {
+	id<MTLFunction> vtxFunc = plDesc.vertexFunction;
+	MTLVertexDescriptor* vtxDesc = plDesc.vertexDescriptor;
+	if ( !vtxFunc || !vtxDesc ) { return; }
+
+	NSInteger srcBuffIdx = -1;
+	for (NSUInteger loc = 0; loc < 31; loc++) {
+		if (vtxDesc.attributes[loc].format != MTLVertexFormatInvalid) {
+			srcBuffIdx = vtxDesc.attributes[loc].bufferIndex;
+			break;
+		}
+	}
 
+	for (MTLVertexAttribute* attr in vtxFunc.vertexAttributes) {
+		if ( !attr.isActive ) { continue; }
+		NSUInteger loc = attr.attributeIndex;
+		if (vtxDesc.attributes[loc].format != MTLVertexFormatInvalid) { continue; }
+		if (srcBuffIdx < 0) {
+			// No vertex buffer in this pipeline: binding 0's slot is reserved and unused
+			// (initReservedVertexAttributeBufferCount()), so the device's placeholder
+			// buffer is bound there at draw time, read at offset 0 for every vertex.
+			srcBuffIdx = getMetalBufferIndexForVertexAttributeBinding(0);
+			vtxDesc.layouts[srcBuffIdx].stride = 4;
+			vtxDesc.layouts[srcBuffIdx].stepFunction = MTLVertexStepFunctionConstant;
+			vtxDesc.layouts[srcBuffIdx].stepRate = 0;
+			_placeholderVertexBufferIndex = (int32_t)srcBuffIdx;
+			_mtlVertexBuffers.set(srcBuffIdx);
+		}
+		MTLVertexFormat fmt;
+		switch (attr.attributeType) {
+			case MTLDataTypeInt: case MTLDataTypeInt2: case MTLDataTypeInt3: case MTLDataTypeInt4:
+			case MTLDataTypeShort: case MTLDataTypeShort2: case MTLDataTypeShort3: case MTLDataTypeShort4:
+			case MTLDataTypeChar: case MTLDataTypeChar2: case MTLDataTypeChar3: case MTLDataTypeChar4:
+				fmt = MTLVertexFormatChar;
+				break;
+			case MTLDataTypeUInt: case MTLDataTypeUInt2: case MTLDataTypeUInt3: case MTLDataTypeUInt4:
+			case MTLDataTypeUShort: case MTLDataTypeUShort2: case MTLDataTypeUShort3: case MTLDataTypeUShort4:
+			case MTLDataTypeUChar: case MTLDataTypeUChar2: case MTLDataTypeUChar3: case MTLDataTypeUChar4:
+			case MTLDataTypeBool: case MTLDataTypeBool2: case MTLDataTypeBool3: case MTLDataTypeBool4:
+				fmt = MTLVertexFormatUChar;
+				break;
+			default:
+				fmt = MTLVertexFormatUCharNormalized;
+				break;
+		}
+		vtxDesc.attributes[loc].format = fmt;
+		vtxDesc.attributes[loc].bufferIndex = srcBuffIdx;
+		vtxDesc.attributes[loc].offset = 0;
+		reportWarning(VK_SUCCESS, "Vertex shader reads attribute %s at location %lu, which the pipeline does not describe. Feeding it a placeholder from vertex buffer %ld.",
+					  attr.name.UTF8String, (unsigned long)loc, (long)srcBuffIdx);
+	}
+}
