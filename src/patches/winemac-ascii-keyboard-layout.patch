--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -562,10 +562,39 @@
         if (!source1 || !source2)
             return FALSE;
         return CFEqual(source1, source2);
+    }
+
+    /* Gamify: with the Mac Driver option ASCIIKeyboardLayout, Windows programs get the
+       ASCII-capable layout macOS keeps next to the selected input source (ABC, U.S., ...)
+       whenever the selected layout cannot type Latin letters (Hebrew, Russian, Greek,
+       Arabic, ...). Games that resolve key bindings through the layout ("W" -> the key that
+       types "w", Wolfenstein II) otherwise lose every letter binding; AZERTY, QWERTZ and
+       other ASCII-capable layouts are kept as they are. *substituted says which one. */
+    static TISInputSourceRef copy_keyboard_layout_input_source(BOOL *substituted)
+    {
+        TISInputSourceRef layout = TISCopyCurrentKeyboardLayoutInputSource();
+
+        if (substituted) *substituted = FALSE;
+        if (ascii_keyboard_layout && layout)
+        {
+            CFBooleanRef ascii = TISGetInputSourceProperty(layout, kTISPropertyInputSourceIsASCIICapable);
+            if (!ascii || !CFBooleanGetValue(ascii))
+            {
+                TISInputSourceRef ascii_layout = TISCopyCurrentASCIICapableKeyboardLayoutInputSource();
+                if (ascii_layout)
+                {
+                    CFRelease(layout);
+                    layout = ascii_layout;
+                    if (substituted) *substituted = TRUE;
+                }
+            }
+        }
+        return layout;
     }
 
     - (void) keyboardSelectionDidChange:(BOOL)force
     {
+        BOOL substituted;
         TISInputSourceRef inputSource, inputSourceLayout;
 
         if (!force)
@@ -576,7 +605,7 @@
         }
 
         inputSource = TISCopyCurrentKeyboardInputSource();
-        inputSourceLayout = TISCopyCurrentKeyboardLayoutInputSource();
+        inputSourceLayout = copy_keyboard_layout_input_source(&substituted);
         if (!force && EqualInputSource(inputSource, lastKeyboardInputSource) &&
             EqualInputSource(inputSourceLayout, lastKeyboardLayoutInputSource))
         {
@@ -606,7 +635,8 @@
                 event->keyboard_changed.keyboard_type = self.keyboardType;
                 event->keyboard_changed.iso_keyboard = (KBGetLayoutType(self.keyboardType) == kKeyboardISO);
                 event->keyboard_changed.uchr = CFDataCreateCopy(NULL, uchr);
-                event->keyboard_changed.input_source = (TISInputSourceRef)CFRetain(inputSource);
+                /* The substituted layout also stands in for the input source (its HKL). */
+                event->keyboard_changed.input_source = (TISInputSourceRef)CFRetain(substituted ? inputSourceLayout : inputSource);
 
                 if (event->keyboard_changed.uchr)
                 {
@@ -2727,19 +2757,21 @@
 {
     OnMainThread(^{
         TISInputSourceRef inputSourceLayout;
+        BOOL substituted;
 
-        inputSourceLayout = TISCopyCurrentKeyboardLayoutInputSource();
+        inputSourceLayout = copy_keyboard_layout_input_source(&substituted);
         if (inputSourceLayout)
         {
             CFDataRef data = TISGetInputSourceProperty(inputSourceLayout,
                                 kTISPropertyUnicodeKeyLayoutData);
             *uchr = CFDataCreateCopy(NULL, data);
-            CFRelease(inputSourceLayout);
 
             *keyboard_type = [WineApplicationController sharedController].keyboardType;
             *is_iso = (KBGetLayoutType(*keyboard_type) == kKeyboardISO);
             if (input_source)
-                *input_source = TISCopyCurrentKeyboardInputSource();
+                *input_source = substituted ? (TISInputSourceRef)CFRetain(inputSourceLayout)
+                                            : TISCopyCurrentKeyboardInputSource();
+            CFRelease(inputSourceLayout);
         }
     });
 }
