+/* Gamify HACK (Game Mode): macOS turns Game Mode on only for a frontmost, full-screen app
+ * that LaunchServices knows as a game from its bundle's Info.plist. It never reads the
+ * Info.plist linked into the loader (__info_plist), so a bare loader or a link to it never
+ * qualifies. The link therefore goes into a minimal bundle,
+ * <tempdir>/<exe_name>.app/Contents/MacOS/<exe_name>, whose Info.plist is the loader's own
+ * (loader/wine_info.plist.in, same name as the flat link) plus the game keys. */
+static const char bundle_info_plist[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
