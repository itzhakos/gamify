+    "    <key>CFBundleAllowMixedLocalizations</key>\n"
+    "    <true/>\n"
+    "    <key>CFBundleDevelopmentRegion</key>\n"
+    "    <string>English</string>\n"
+    "    <key>CFBundleExecutable</key>\n"
+    "    <string>%s</string>\n"
+    "    <key>CFBundleIdentifier</key>\n"
+    "    <string>local.gamify.wine.%s</string>\n"
+    "    <key>CFBundleInfoDictionaryVersion</key>\n"
+    "    <string>6.0</string>\n"
+    "    <key>CFBundleName</key>\n"
+    "    <string>%s</string>\n"
+    "    <key>CFBundlePackageType</key>\n"
+    "    <string>APPL</string>\n"
+    "    <key>CFBundleShortVersionString</key>\n"
+    "    <string>" PACKAGE_VERSION "</string>\n"
+    "    <key>CFBundleSignature</key>\n"
+    "    <string>?\?\?\?</string>\n"
+    "    <key>CFBundleVersion</key>\n"
+    "    <string>" PACKAGE_VERSION "</string>\n"
+    "    <key>NSPrincipalClass</key>\n"
+    "    <string>WineApplication</string>\n"
+    "    <key>LSUIElement</key>\n"
+    "    <string>1</string>\n"
+    "    <key>LSApplicationCategoryType</key>\n"
+    "    <string>public.app-category.games</string>\n"
+    "    <key>GCSupportsGameMode</key>\n"
+    "    <true/>\n"
+    "    <key>LSSupportsGameMode</key>\n"
+    "    <true/>\n"
+    "</dict>\n"
+    "</plist>\n";
+
+/* Escape &, < and > for a plist <string>. */
+static char *plist_escape(const char *str)
+{
+    const char *p;
+    char *ret, *q;
+    size_t len = 1;
+
+    for (p = str; *p; p++)
+        len += *p == '&' ? 5 : (*p == '<' || *p == '>') ? 4 : 1;
+    if (!(ret = malloc(len)))
+        return NULL;
+    for (p = str, q = ret; *p; p++)
+    {
+        if (*p == '&') q = stpcpy(q, "&amp;");
+        else if (*p == '<') q = stpcpy(q, "&lt;");
+        else if (*p == '>') q = stpcpy(q, "&gt;");
+        else *q++ = *p;
+    }
+    *q = 0;
+    return ret;
+}
+
+/* Write contents to path through a temporary file and rename(), unless path holds them already. */
+static BOOL write_bundle_file(const char *path, const char *contents)
+{
+    size_t len = strlen(contents);
+    char *buf, *tmp;
+    BOOL ret = FALSE;
+    int fd;
+
+    if ((fd = open(path, O_RDONLY)) != -1)
+    {
+        if ((buf = malloc(len + 1)))
+        {
+            ret = read(fd, buf, len + 1) == len && !memcmp(buf, contents, len);
+            free(buf);
+        }
+        close(fd);
+        if (ret) return TRUE;
+    }
+    if (asprintf(&tmp, "%s.%d", path, (int)getpid()) == -1)
+        return FALSE;
+    if ((fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644)) != -1)
+    {
+        ret = write(fd, contents, len) == len;
+        close(fd);
+        if (ret) ret = !rename(tmp, path);
+    }
+    if (!ret) unlink(tmp);
+    free(tmp);
+    return ret;
+}
+
+/* The bundled link to the loader: a hard link like the flat one, or a copy where that fails
+ * (e.g. the runtime on another volume). Not a symlink: gamepolicyd follows it to the loader
+ * outside the bundle and ignores the process. NULL on failure. */
+static char *create_preloader_bundle(const char *wineloader_path, const char *exe_name)
+{
+    char *dir = create_tempdir(wineloader_path), *name = NULL, *id = NULL, *plist = NULL;
+    char *app = NULL, *contents = NULL, *macos = NULL, *info = NULL, *exe = NULL, *tmp = NULL, *p;
+    char *ret = NULL;
+    struct stat st;
+
+    if (!dir || !(name = plist_escape(exe_name)) || !(id = strdup(exe_name)))
+        goto done;
+    for (p = id; *p; p++)  /* a bundle id is letters, digits, '.' and '-' */
+        if (!(*p >= 'a' && *p <= 'z') && !(*p >= 'A' && *p <= 'Z') && !(*p >= '0' && *p <= '9') && *p != '.')
+            *p = '-';
+    if (asprintf(&plist, bundle_info_plist, name, id, name) == -1 ||
+        asprintf(&app, "%s%s.app", dir, exe_name) == -1 ||
+        asprintf(&contents, "%s/Contents", app) == -1 ||
+        asprintf(&macos, "%s/MacOS", contents) == -1 ||
+        asprintf(&info, "%s/Info.plist", contents) == -1 ||
+        asprintf(&exe, "%s/%s", macos, exe_name) == -1)
+        goto done;
+
+    /* mkdir may fail if the directory already exists but that's ok */
+    mkdir(app, 0700);
+    mkdir(contents, 0700);
+    mkdir(macos, 0700);
+    if (!write_bundle_file(info, plist))
+        goto done;
+
+    /* If the executable already exists, use it (if it's in this dir, it is the right loader). */
+    if (!stat(exe, &st) || !link(wineloader_path, exe) || errno == EEXIST)
+        ret = exe;
+    else if (asprintf(&tmp, "%s.%d", exe, (int)getpid()) != -1)
+    {
+        if (!copyfile(wineloader_path, tmp, NULL, COPYFILE_DATA | COPYFILE_STAT) && !rename(tmp, exe))
+            ret = exe;
+        else
+            unlink(tmp);
+    }
+
+done:
+    if (ret != exe) free(exe);
+    free(dir); free(name); free(id); free(plist); free(app);
+    free(contents); free(macos); free(info); free(tmp);
+    return ret;
 }
 
