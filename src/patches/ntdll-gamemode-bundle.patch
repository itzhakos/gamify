+/***********************************************************************
+ *           bundle_first_process
+ *
+ * Gamify HACK (Game Mode): the first process of a launch is the loader itself
+ * (bin/wine), outside any bundle, and it runs the program named by its first
+ * argument in this same process. Re-exec it through the bundled link that
+ * preloader_exec() gives every other process (create_preloader_bundle), so that a
+ * program started directly can get Game Mode too; an i386 program goes through
+ * the x87sidecar with that link as its loader. Like the link, only with
+ * WINEDLLPATH set (the link finds ntdll.so through it). A process that already
+ * runs from a bundle (this re-exec) or that the sidecar started (another exec
+ * would drop its hook) runs as is.
+ */
+static void bundle_first_process( int argc, char *argv[] )
+{
+    char self[PATH_MAX], *app_name, *argv0 = argv[0], *bundle = NULL;
+    uint32_t size = sizeof(self);
+
+    if (argc >= 2 && !getenv( "WINESERVERSOCKET" ) && !getenv( "WINEX87SIDECARSTARTED" ) &&
+        getenv( "WINEDLLPATH" ) && (_NSGetExecutablePath( self, &size ) || !strstr( self, ".app/Contents/MacOS/" )) &&
+        (app_name = extract_exe_name( argv[1] )))
+    {
+        /* Pass the app name to the loader through an env var, as preloader_exec() does. */
+        if ((bundle = create_preloader_bundle( wineloader, app_name )))
+            setenv( "WINEPRELOADERAPPNAME", app_name, 1 );
+        free( app_name );
+    }
+    x87_sidecar_first_process( argc, argv, bundle ? bundle : wineloader );
+    if (!bundle) return;
+    argv[0] = bundle;
+    execv( bundle, argv );
+    ERR( "cannot exec %s: %s\n", bundle, strerror( errno ) );
+    argv[0] = argv0;
+    unsetenv( "WINEPRELOADERAPPNAME" );
+    free( bundle );
 }
 #endif
 
