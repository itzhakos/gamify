+/***********************************************************************
+ *              macdrv_create_message_window_data
+ *
+ * Gamify: create Mac data for a message-only window (parent HWND_MESSAGE)
+ * of the current thread when OpenGL needs it.  Windows lets an app set a
+ * pixel format on a message-only window and make a context current on it;
+ * Qt 5 does that for its "QtOpenGLDummyWindow" and QOffscreenSurface.  The
+ * window gets a Cocoa window that is never shown.  Returns the data locked,
+ * like get_win_data(), or NULL if hwnd is not such a window.
+ */
+struct macdrv_win_data *macdrv_create_message_window_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    HWND parent;
+    UINT dpi;
+
+    if (NtUserGetWindowThread(hwnd, NULL) != GetCurrentThreadId()) return NULL;
+    if (!(parent = NtUserGetAncestor(hwnd, GA_PARENT))) return NULL;
+    if (parent == NtUserGetDesktopWindow() || NtUserGetAncestor(parent, GA_PARENT)) return NULL;
+
+    if (!(data = alloc_win_data(hwnd))) return NULL;
+    data->message_only = TRUE;
+
+    dpi = NtUserGetWinMonitorDpi(hwnd, MDT_DEFAULT);
+    NtUserGetWindowRect(hwnd, &data->rects.window, dpi);
+    NtUserGetClientRect(hwnd, &data->rects.client, dpi);
+    NtUserMapWindowPoints(hwnd, 0, (POINT *)&data->rects.client, 2, dpi);
+    data->rects.visible = data->rects.window;
 
+    create_cocoa_window(data);
+    TRACE("message-only win %p/%p window %s client %s\n", hwnd, data->cocoa_window,
+          wine_dbgstr_rect(&data->rects.window), wine_dbgstr_rect(&data->rects.client));
     return data;
 }
 
