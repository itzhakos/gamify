+/* Gamify: OpenGLAttribDeclarationOrder.  Windows drivers give vertex shader inputs that have no
+   explicit location their locations in declaration order, and some games rely on that (Worms
+   W.M.D feeds IN_Position to location 0 without asking); Apple's linker sorts them by name.
+   Before a program is linked, bind the inputs of its vertex shader in declaration order, unless
+   the app binds locations itself or the shader uses layout(location). */
+static void (*pglLinkProgram)(GLuint program);
+static void (*pglBindAttribLocation)(GLuint program, GLuint index, const GLchar *name);
+static void (*pglGetAttachedShaders)(GLuint program, GLsizei max_count, GLsizei *count, GLuint *shaders);
+static void (*pglGetShaderiv)(GLuint shader, GLenum pname, GLint *params);
+static void (*pglGetShaderSource)(GLuint shader, GLsizei size, GLsizei *length, GLchar *source);
+static CFMutableSetRef app_bound_programs;
+static pthread_mutex_t app_bound_programs_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void macdrv_glBindAttribLocation(GLuint program, GLuint index, const GLchar *name)
+{
+    pthread_mutex_lock(&app_bound_programs_mutex);
+    if (!app_bound_programs) app_bound_programs = CFSetCreateMutable(NULL, 0, NULL);
+    if (app_bound_programs) CFSetAddValue(app_bound_programs, (const void *)(UINT_PTR)program);
+    pthread_mutex_unlock(&app_bound_programs_mutex);
+    pglBindAttribLocation(program, index, name);
+}
+
+/* Strip comments and preprocessor lines in place. */
+static void strip_glsl(char *src)
+{
+    char *in = src, *out = src;
+    BOOL line_start = TRUE;
 
+    while (*in)
+    {
+        if (in[0] == '/' && in[1] == '/')
+            while (*in && *in != '\n') in++;
+        else if (in[0] == '/' && in[1] == '*')
+        {
+            for (in += 2; *in && !(in[0] == '*' && in[1] == '/'); in++);
+            if (*in) in += 2;
+            *out++ = ' ';
+        }
+        else if (line_start && *in == '#')
+        {
+            while (*in && *in != '\n') in += (in[0] == '\\' && in[1] == '\n') ? 2 : 1;
+        }
+        else
+        {
+            if (*in == '\n') line_start = TRUE;
+            else if (*in != ' ' && *in != '\t' && *in != '\r') line_start = FALSE;
+            *out++ = *in++;
+        }
+    }
+    *out = 0;
+}
+
+static BOOL is_glsl_qualifier(const char *token)
+{
+    static const char * const qualifiers[] =
+        { "centroid", "sample", "smooth", "flat", "noperspective", "invariant", "precise",
+          "highp", "mediump", "lowp" };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(qualifiers); i++)
+        if (!strcmp(token, qualifiers[i])) return TRUE;
+    return FALSE;
+}
+
+/* Parse one global declaration; append the names of vertex inputs to names/slots.
+   Returns FALSE if the declaration has an explicit location. */
+static BOOL parse_glsl_input(char *stmt, const char **names, int *slots, int *count, int max)
+{
+    char *tokens[64], *p, *ctx;
+    int n = 0, i, type_slots;
+
+    if (strstr(stmt, "layout"))
+    {
+        if (strstr(stmt, "location")) return FALSE;
+        if ((p = strchr(stmt, ')'))) stmt = p + 1;
+    }
+    for (p = strtok_r(stmt, " \t\r\n,[]", &ctx); p && n < ARRAY_SIZE(tokens); p = strtok_r(NULL, " \t\r\n,[]", &ctx))
+        tokens[n++] = p;
+
+    for (i = 0; i < n && is_glsl_qualifier(tokens[i]); i++);
+    if (i >= n || (strcmp(tokens[i], "in") && strcmp(tokens[i], "attribute"))) return TRUE;
+    for (i++; i < n && is_glsl_qualifier(tokens[i]); i++);
+    if (i >= n || strchr(tokens[i], '(')) return TRUE;
+
+    type_slots = 1;
+    if (!strncmp(tokens[i], "mat", 3) && tokens[i][3] >= '2' && tokens[i][3] <= '4')
+        type_slots = tokens[i][3] - '0';
+
+    for (i++; i < n && *count < max; i++)
+    {
+        if (tokens[i][0] >= '0' && tokens[i][0] <= '9')  /* array size of the previous name */
+        {
+            if (*count) slots[*count - 1] = type_slots * atoi(tokens[i]);
+            continue;
+        }
+        names[*count] = tokens[i];
+        slots[*count] = type_slots;
+        (*count)++;
+    }
+    return TRUE;
+}
+
+static void bind_vertex_inputs_in_order(GLuint program)
+{
+    GLuint shaders[16];
+    GLsizei shader_count = 0, i;
+
+    pglGetAttachedShaders(program, ARRAY_SIZE(shaders), &shader_count, shaders);
+    for (i = 0; i < shader_count; i++)
+    {
+        const char *names[32];
+        int slots[32], count = 0, depth = 0, j;
+        GLint type = 0, length = 0;
+        char *src, *p, *stmt;
+        GLuint location = 0;
+
+        pglGetShaderiv(shaders[i], GL_SHADER_TYPE, &type);
+        if (type != GL_VERTEX_SHADER) continue;
+        pglGetShaderiv(shaders[i], GL_SHADER_SOURCE_LENGTH, &length);
+        if (length <= 0 || !(src = malloc(length + 1))) continue;
+        pglGetShaderSource(shaders[i], length + 1, NULL, src);
+        src[length] = 0;
+        strip_glsl(src);
+
+        /* walk the declarations at global scope */
+        for (p = stmt = src; *p; p++)
+        {
+            if (*p == '{') depth++;
+            else if (*p == '}') { if (depth) depth--; if (!depth) stmt = p + 1; }
+            else if (*p == ';' && !depth)
+            {
+                *p = 0;
+                if (!parse_glsl_input(stmt, names, slots, &count, ARRAY_SIZE(names)))
+                {
+                    TRACE("program %u shader %u uses explicit locations\n", program, shaders[i]);
+                    count = 0;
+                    break;
+                }
+                stmt = p + 1;
+            }
+        }
+
+        for (j = 0; j < count && location < 16; j++)
+        {
+            if (strncmp(names[j], "gl_", 3))
+            {
+                TRACE("program %u: %s -> %u\n", program, names[j], location);
+                pglBindAttribLocation(program, location, names[j]);
+            }
+            location += slots[j];
+        }
+        free(src);
+    }
+}
+
+static void macdrv_glLinkProgram(GLuint program)
+{
+    BOOL app_bound;
+
+    pthread_mutex_lock(&app_bound_programs_mutex);
+    app_bound = app_bound_programs && CFSetContainsValue(app_bound_programs, (const void *)(UINT_PTR)program);
+    pthread_mutex_unlock(&app_bound_programs_mutex);
+
+    if (!app_bound) bind_vertex_inputs_in_order(program);
+    pglLinkProgram(program);
+}
+
+/* Gamify: ForceOpenGLCoreContext, binding VAO 0 means binding the context's default VAO */
+
+static void macdrv_glBindVertexArray(GLuint array)
+{
+    struct wgl_context *context = NtCurrentTeb()->glContext;
+
+    if (!array && context) array = context->default_vao;
+    pglBindVertexArray(array);
+}
