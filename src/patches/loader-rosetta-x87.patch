+/* HACK: start i386 processes under the x87sidecar (https://github.com/athei/x87sidecar)
+ * in cooperative mode, so that its x87 JIT hook replaces Rosetta's slow x87 emulation.
+ * Ported from athei/wine cx-26-patched ("ntdll: HACK: Start i386 processes under the
+ * x87sidecar cooperatively") to CrossOver 25.1, without its compatdb.so rules and
+ * without a bundled default: only ROSETTA_X87_PATH turns it on, so a runtime with
+ * this patch behaves as before unless the variable is set. */
+
+/***********************************************************************
+ *           get_x87_sidecar_path
+ *
+ * The x87sidecar binary from ROSETTA_X87_PATH, or NULL if it is unset or empty.
+ */
+static const char *get_x87_sidecar_path(void)
+{
+    const char *path = getenv( "ROSETTA_X87_PATH" );
+
+    return path && *path ? path : NULL;
+}
+
+/* Read the machine field from a PE file's headers.
+ * Returns IMAGE_FILE_MACHINE_UNKNOWN if the file can't be read or isn't PE. */
+static WORD get_pe_file_machine( const char *path )
+{
+    IMAGE_DOS_HEADER dos;
+    IMAGE_FILE_HEADER file_header;
+    DWORD signature;
+    WORD ret = IMAGE_FILE_MACHINE_UNKNOWN;
+    int fd = open( path, O_RDONLY );
+
+    if (fd == -1) return ret;
+    if (pread( fd, &dos, sizeof(dos), 0 ) == sizeof(dos) &&
+        dos.e_magic == IMAGE_DOS_SIGNATURE &&
+        pread( fd, &signature, sizeof(signature), dos.e_lfanew ) == sizeof(signature) &&
+        signature == IMAGE_NT_SIGNATURE &&
+        pread( fd, &file_header, sizeof(file_header),
+               dos.e_lfanew + sizeof(signature) ) == sizeof(file_header))
+        ret = file_header.Machine;
+    close( fd );
+    return ret;
+}
+
+/***********************************************************************
+ *           get_dos_drive_unix_path
+ *
+ * Map a DOS path with a drive letter, X:\dir\file, to the unix path
+ * <config_dir>/dosdevices/x:/dir/file and resolve it with realpath. Returns
+ * NULL if arg is not such a path or the file does not exist.
+ */
+static char *get_dos_drive_unix_path( const char *arg )
+{
+    char drive = arg[0] | 0x20, *path = NULL, *p, *ret;
+
+    if (!config_dir || drive < 'a' || drive > 'z' || arg[1] != ':') return NULL;
+    asprintf( &path, "%s/dosdevices/%c:/%s", config_dir, drive, arg + 2 );
+    if (!path) return NULL;
+    for (p = path + strlen( config_dir ); *p; p++) if (*p == '\\') *p = '/';
+    ret = realpath( path, NULL );
+    free( path );
+    return ret;
+}
+
+/***********************************************************************
+ *           x87_sidecar_exec
+ *
+ * Exec `<sidecar> --cooperative <loader> <args...>`, where args is the loader's
+ * argv (args[0] is the loader). The sidecar execs the loader in place, keeping
+ * the pid, and the loader hands it its task port in x87_cooperative_handshake().
+ * If the sidecar cannot hook this Rosetta it execs the loader without the hook.
+ * Returns only if the exec failed.
+ */
+static void x87_sidecar_exec( const char *sidecar, char **args, const char *target )
+{
+    static char coop_flag[] = "--cooperative";
+    char **argv;
+    int i, n;
+
+    for (n = 0; args[n]; n++) {}
+    if (!(argv = malloc( (n + 3) * sizeof(*argv) ))) return;
+    argv[0] = (char *)sidecar;
+    argv[1] = coop_flag;
+    for (i = 0; i <= n; i++) argv[i + 2] = args[i];  /* args[0..n-1] + NULL */
+    ERR( "ROSETTA_X87_PATH: attaching x87sidecar --cooperative (%s) for %s\n", sidecar, target );
+    execv( sidecar, argv );
+    ERR( "cannot exec x87sidecar %s: %s\n", sidecar, strerror( errno ) );
+    free( argv );
+}
 #endif
 
 
