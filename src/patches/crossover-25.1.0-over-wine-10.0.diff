diff -ruN -X ../excl.txt a/server/esync.c b/server/esync.c
--- a/server/esync.c	1970-01-01 02:00:00
+++ b/server/esync.c	2025-08-07 13:54:45
@@ -0,0 +1,697 @@
+/*
+ * eventfd-based synchronization objects
+ *
+ * Copyright (C) 2018 Zebediah Figura
